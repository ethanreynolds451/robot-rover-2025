<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_networking</name>
  <version>0.0.0</version>
  <description>All code to manage interfacing between computer and connected devices</description>
  <maintainer email="ethanreynolds451@gmail.com">ethanreynolds</maintainer>
  <license>None</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- Dependencies for serial communication -->
  <build_depend>python3-serial</build_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
